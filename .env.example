# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Local development ---
DJANGO_DEBUG=True
# DJANGO_USE_EXTENSIONS=True   # enables django-extensions (pip install -r requirements-dev.txt)

# --- Production (example) ---
# DJANGO_DEBUG=False
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Database (SQLite by default). PostgreSQL example:
# DATABASE_URL=postgres://medium:password@localhost:5432/medium

# Serve uploaded media through Django when DEBUG=False (small deploys only)
# DJANGO_SERVE_MEDIA=True
# DJANGO_MEDIA_ROOT=/var/data/media

# HTTPS / HSTS (defaults are fine for a normal HTTPS deploy)
# DJANGO_USE_HTTPS=True
# DJANGO_HSTS_SECONDS=2592000

# Hold new comments until approved in the admin
# COMMENTS_REQUIRE_APPROVAL=True

# DJANGO_TIME_ZONE=UTC
# DJANGO_LOG_LEVEL=INFO
